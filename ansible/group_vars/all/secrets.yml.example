---
# ============================================================
# CragPillars - Secret variables example
# ============================================================
# Copy this file to group_vars/all/secrets.yml.
# Replace all placeholders with your own credentials.
# Encrypt the resulting file using ansible-vault encrypt.

# Administrator password
vault_crag_admin_password_hash: "REPLACE_WITH_PASSWORD_HASH"

# Administrator MFA
vault_crag_admin_totp_secret: "REPLACE_WITH_TOTP_SECRET"

# MariaDB credentials
vault_mariadb_app_password: "REPLACE_WITH_DATABASE_PASSWORD"

# Web administration credentials
vault_web_username: "crag_webadmin"
vault_web_password: "REPLACE_WITH_WEB_PASSWORD"
